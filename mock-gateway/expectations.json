[
  {
    "httpRequest": {
      "method": "POST",
      "path": "/api/test"
    },
    "httpResponse": {
      "statusCode": 200,
      "headers": {
        "Content-Type": ["application/json"]
      },
      "body": {
        "success": true,
        "message": "Mock gateway response",
        "timestamp": "{{now}}",
        "request_id": "{{request.body.request_id}}"
      }
    }
  },
  {
    "httpRequest": {
      "method": "POST",
      "path": "/api/fail"
    },
    "httpResponse": {
      "statusCode": 500,
      "headers": {
        "Content-Type": ["application/json"]
      },
      "body": {
        "success": false,
        "error": "Internal server error",
        "timestamp": "{{now}}"
      }
    }
  }
]
