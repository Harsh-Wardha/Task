# Environment variables for the microservices demo

# Service Configuration
NODE_ENV=development
LOG_LEVEL=info

# Agent Demo Service
AGENT_DEMO_PORT=3001

# Agent Custom Service
AGENT_CUSTOM_PORT=3002
GATEWAY_URL=http://mock-gateway:1080/api/test
GATEWAY_API_KEY=demo-api-key-12345

# OpenTelemetry/Jaeger Configuration
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Docker Compose Network
COMPOSE_PROJECT_NAME=nodejs-microservices-demo
